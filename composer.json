    "type": "project",
    "require": {
        "php": "^8.1",
        "monolog/monolog": "^3.4",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
